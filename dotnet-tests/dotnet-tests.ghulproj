<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library on .NET: its sources and a few tests compiled into one
       .NET program, which finds them through .NET's own reflection. CI runs
       it and compares what it writes with run.expected. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ghul.runtime" Version="50.3.1" />
    <GhulSources Include="*.ghul" />
    <GhulSources Include="../src/**/*.ghul" />
  </ItemGroup>
</Project>
