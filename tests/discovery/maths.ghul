// Tests the runner finds by reflection: instance and static methods, a
// private one, global functions, and a failure and an error among them.
namespace Maths is
    class Arithmetic is
        _base: int

        init() is
            _base = 40
        si

        @test()
        adds() is
            assert _base + 2 == 42
        si

        @test()
        _subtracts_privately() is
            assert _base - 2 == 38
        si

        @test()
        multiplies() static is
            throw Ghul.AssertFailedException("six sevens is not 41")
        si

        not_a_test() is
            throw Ghul.InvalidOperationException("never run")
        si
    si

    @test()
    divides() is
        let zero = 0
        assert 1 / zero == 0
    si

    @test()
    negates() is
        assert -(-1) == 1
    si
si
